# Copy to backend/.env for local development. Never commit the real .env file.
# On Render, set these as environment variables instead.

# MySQL connection
DB_URL=jdbc:mysql://localhost:3306/evsmartai?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USER=root
DB_PASSWORD=change_me

# At least 32 characters; generate one with: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_value_of_at_least_32_chars
JWT_EXPIRATION_MS=86400000

# Frontend origin(s), comma-separated, no trailing slash. Wildcards allowed (covers Vercel preview URLs).
APP_CORS_ORIGIN=http://localhost:5173
# Example for production:
# APP_CORS_ORIGIN=https://ev-smart-ai.vercel.app,https://ev-smart-*-rithwik9.vercel.app

# Optional: only used if you run a separate AI service
AI_SERVICE_URL=http://localhost:8000
